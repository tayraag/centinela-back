# =============================================
# El Centinela — Variables de Entorno
# Copiar este archivo como .env y rellenar los valores reales.
# NUNCA commitear el .env real — ya está en .gitignore
# =============================================

# --- Base de Datos PostgreSQL ---
# Formato: host=<host> user=<user> password=<pass> dbname=<db> port=<port> sslmode=disable TimeZone=America/Argentina/Buenos_Aires
DB_DSN=host=localhost user=centinela_admin password=centinela_password dbname=centinela_db port=5433 sslmode=disable TimeZone=America/Argentina/Buenos_Aires

# --- JWT ---
# Clave secreta para firmar tokens. Mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_de_al_menos_32_chars

# Tiempo de vida del access token (en horas)
JWT_ACCESS_TTL_HOURS=8

# Tiempo de vida del refresh token (en días)
JWT_REFRESH_TTL_DAYS=30

# --- TOTP / 2FA ---
# Clave AES-256 para cifrar los secretos TOTP en la BD.
# DEBE ser exactamente 32 caracteres ASCII (= 256 bits).
# Generar con: openssl rand -hex 16  (produce 32 chars hex)
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Nombre de la app que aparece en Google Authenticator / Authy
APP_NAME=El Centinela

# --- Proxmox VE ---
# Host del cluster (sin barra final).
PROXMOX_BASE_URL=https://100.81.49.19:8006
# Nodo del cluster (hoy es un cluster de un solo nodo).
PROXMOX_NODE=pve
# Usuario en formato user@realm (ej: root@pam). Se autentica con ticket + CSRF,
# el mismo mecanismo que usa la web UI de Proxmox.
PROXMOX_USERNAME=root@pam
PROXMOX_PASSWORD=

# Fingerprint SHA-256 del certificado TLS real de Proxmox (con o sin ":").
# Es el modo que se debe usar en cualquier entorno real: pinnea el certificado
# exacto en vez de confiar en una CA.
PROXMOX_TLS_FINGERPRINT=

# Fallback mientras no se tenga el fingerprint real a mano: saltea toda
# verificación TLS. NUNCA usar esto fuera de desarrollo local.
PROXMOX_TLS_INSECURE=true
