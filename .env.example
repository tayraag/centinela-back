# =============================================
# El Centinela — Variables de Entorno
# Copiar este archivo como .env y rellenar los valores reales.
# NUNCA commitear el .env real — ya está en .gitignore
# =============================================

# --- Base de Datos PostgreSQL ---
# Formato: host=<host> user=<user> password=<pass> dbname=<db> port=<port> sslmode=disable TimeZone=America/Argentina/Buenos_Aires
DB_DSN=host=localhost user=centinela_admin password=centinela_password dbname=centinela_db port=5433 sslmode=disable TimeZone=America/Argentina/Buenos_Aires

# --- JWT ---
# Clave secreta para firmar tokens. Mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_de_al_menos_32_chars

# Tiempo de vida del access token (en horas)
JWT_ACCESS_TTL_HOURS=8

# Tiempo de vida del refresh token (en días)
JWT_REFRESH_TTL_DAYS=30

# --- TOTP / 2FA ---
# Clave AES-256 para cifrar los secretos TOTP en la BD.
# DEBE ser exactamente 32 caracteres ASCII (= 256 bits).
# Generar con: openssl rand -hex 16  (produce 32 chars hex)
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Nombre de la app que aparece en Google Authenticator / Authy
APP_NAME=El Centinela

# --- CORS ---
# Lista de orígenes permitidos, separados por coma (sin espacios al inicio/fin).
# Usar el dominio exacto del frontend. Nunca usar *.
# En producción (Tailscale):
ALLOWED_ORIGINS=https://tu-app.tail.ts.net
# En desarrollo local agregar el puerto del front, por ejemplo:
# ALLOWED_ORIGINS=https://tu-app.tail.ts.net,http://localhost:5173
# --- Proxmox VE ---
# URL base de la API de Proxmox (ej: https://10.7.93.124:8006 o https://10.7.93.124:8006/api2/json)
PROXMOX_URL=https://10.7.93.124:8006
# PROXMOX_BASE_URL=https://10.7.93.124:8006 # (alias alternativo)

# Nodo del cluster (ej: pve o pve-node-01)
PROXMOX_NODE=pve-node-01

# Autenticación con API Token (única forma de autenticación soportada).
# Si falta alguno de los dos, los endpoints de /api/instances responden 502.
PROXMOX_TOKEN_ID=centinela-api@pve!backend-token
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Fingerprint SHA-256 del certificado TLS real de Proxmox (con o sin ":").
# Es el modo que se debe usar en cualquier entorno real: pinnea el certificado
# exacto en vez de confiar en una CA.
PROXMOX_TLS_FINGERPRINT=

# Saltear verificación TLS (InsecureSkipVerify). Necesario en desarrollo local si el certificado es autofirmado.
PROXMOX_INSECURE_SKIP_VERIFY=true
PROXMOX_TLS_INSECURE=true

# VMIDs de la infraestructura de El Centinela que no se pueden apagar desde la API.
# Vacío = 100,101,102,103,104,105.
PROXMOX_PROTECTED_VMIDS=

# --- Redis ---
# Dirección y puerto del servicio Redis (redis:6379 en Docker / localhost:6379 si se expone en local)
#Aca tienen que poner una clave para levantar redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=centinela_redis_password

